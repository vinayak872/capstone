# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# GitHub Configuration (for Actions runs, logs & workflow trigger)
# Generate a Personal Access Token with repo + workflow scopes: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=vinayak872
GITHUB_REPO=capstone
GITHUB_WORKFLOW_FILE=ci.yml

# ArgoCD Configuration (for Application sync & health queries)
# Default port-forward: kubectl port-forward svc/argocd-server -n argocd 8080:443
ARGOCD_SERVER=https://localhost:8080
ARGOCD_TOKEN=
ARGOCD_INSECURE_TLS=true
ARGOCD_APP_NAME=sample-app

# Kubernetes Configuration (for live pod & deployment status)
# Default: ~/.kube/config (kind-cloud05 cluster)
KUBECONFIG_PATH=
K8S_NAMESPACE=default

# Prometheus Configuration (for progressive delivery metric checks in Semester VIII)
# Default port-forward: kubectl port-forward svc/prometheus-server -n prometheus 9090:80
PROMETHEUS_URL=http://localhost:9090
